[
  {
    "index": 1,
    "start": 0.0,
    "end": 2.88,
    "text": "ادھہ ایپ اڑزم دشادی ہوگ"
  },
  {
    "index": 2,
    "start": 2.88,
    "end": 8.28,
    "text": "درتراشت رواج دھرمکشترے کروکشترے سنوے تھا یویت سو ہا"
  },
  {
    "index": 3,
    "start": 8.28,
    "end": 11.88,
    "text": "مام کا ہا پانڈا واشتے وکیم کروکت سنجے"
  },
  {
    "index": 4,
    "start": 11.88,
    "end": 13.46,
    "text": "درتراشت نے کہا"
  },
  {
    "index": 5,
    "start": 13.46,
    "end": 14.38,
    "text": "ہے سنجے"
  },
  {
    "index": 6,
    "start": 14.38,
    "end": 18.8,
    "text": "دھرم بھومی کروکشتر میں ایک اترہ ہوئے یدھ کے اچھوک یویت سو"
  },
  {
    "index": 7,
    "start": 18.8,
    "end": 21.46,
    "text": "میرے اور پانڈوں کے پتروں نے کیا کیا"
  },
  {
    "index": 8,
    "start": 21.46,
    "end": 26.8,
    "text": "سنجے اواج درشتواتوں پانڈاوانی کم ویوڑھا دوریو دھنستدہ"
  },
  {
    "index": 9,
    "start": 26.8,
    "end": 31.07,
    "text": "آچاریہ مپسنگمی راجع اپچنم مبروید سنجے"
  },
  {
    "index": 10,
    "start": 31.07,
    "end": 31.61,
    "text": "نے کہا"
  },
  {
    "index": 11,
    "start": 31.61,
    "end": 34.39,
    "text": "پانڈا سنگی کی ویوھ رچنہ دیکھا راجع دوریو دھن"
  },
  {
    "index": 12,
    "start": 34.39,
    "end": 37.21,
    "text": "نے آچارے درون کے پاس جا کری اوچن کہیں"
  },
  {
    "index": 13,
    "start": 37.21,
    "end": 40.61,
    "text": "پسشے تھا پانڈو پترانہ ماچاری محتی چھموں"
  },
  {
    "index": 14,
    "start": 40.61,
    "end": 43.89,
    "text": "ویوڑھا بروپت پترین تھا وہ ششن دھیم تھا"
  },
  {
    "index": 15,
    "start": 43.89,
    "end": 48.99,
    "text": "ہے آچاریہ آپ کے بدھیمان ششت دروپت پترہ درشتد دیمنا دوارہ"
  },
  {
    "index": 16,
    "start": 48.99,
    "end": 53.85,
    "text": "ویوھا کار کھڑی کی گئی پانڈو پتروں کی اس محتی سینہ کو دیکھئے"
  },
  {
    "index": 17,
    "start": 53.85,
    "end": 57.7,
    "text": "آتر شورہ محشواصہ بھیمجن سمائیو دھی"
  },
  {
    "index": 18,
    "start": 57.7,
    "end": 61.24,
    "text": "یو یو دھنوں ویراکشچہ دروپت داشچہ محارت تھا"
  },
  {
    "index": 19,
    "start": 61.24,
    "end": 64.5,
    "text": "اس سینہ محان دھنورداری شور یو دھا ہے"
  },
  {
    "index": 20,
    "start": 64.5,
    "end": 67.54,
    "text": "جو یو دھنے بھیم اور ارجن کے سمان ہے"
  },
  {
    "index": 21,
    "start": 67.54,
    "end": 72.18,
    "text": "جیسے یو یو دھن ویراکت تھا محارتی راجع دروپت"
  },
  {
    "index": 22,
    "start": 72.18,
    "end": 75.82,
    "text": "درشت کے تشچے کی تانہا ہے کاشی راجشچہ ویریوان"
  },
  {
    "index": 23,
    "start": 75.82,
    "end": 79.18,
    "text": "پروجت کنتی بھوجشچہ شیبیسچہ نرپوں گوہا"
  },
  {
    "index": 24,
    "start": 79.18,
    "end": 83.28,
    "text": "درشت کے دو چیکتان بلوان کاشی راج"
  },
  {
    "index": 25,
    "start": 83.28,
    "end": 88.0,
    "text": "پروجت کنتی بھوج اور منشوں میں شریشت شیبیہ"
  },
  {
    "index": 26,
    "start": 88.0,
    "end": 91.64,
    "text": "یو دھا منیوشچہ ویقرانت اتماوجشچہ ویریوان"
  },
  {
    "index": 27,
    "start": 91.64,
    "end": 94.94,
    "text": "سو بھا دروپت دیاشچہ سروے و محارت تھا"
  },
  {
    "index": 28,
    "start": 94.94,
    "end": 98.58,
    "text": "پر آکرمی یو دھا منیو بلوان اتماوجہ"
  },
  {
    "index": 29,
    "start": 98.58,
    "end": 101.98,
    "text": "سو بھا دراپوترا بھیمنیو اور دروپت دی کے پوترا"
  },
  {
    "index": 30,
    "start": 101.98,
    "end": 103.91,
    "text": "یہ سب محارتی ہے"
  },
  {
    "index": 31,
    "start": 104.17,
    "end": 107.83,
    "text": "اس ماکم تو ویششتہ یہ تانی بود دویجو"
  },
  {
    "index": 32,
    "start": 107.83,
    "end": 111.53,
    "text": "تم نائکہ ممس ایننے سے سنگیار"
  },
  {
    "index": 33,
    "start": 111.53,
    "end": 113.37,
    "text": "تھم تانبرا بیمیتے"
  },
  {
    "index": 34,
    "start": 113.37,
    "end": 117.05,
    "text": "دویجو تم ہمارے پکش میں جو ویششت یو دھاگن"
  },
  {
    "index": 35,
    "start": 117.05,
    "end": 120.01,
    "text": "ہیں ان کو آپ جانلی جے آپ کی جانکاری"
  },
  {
    "index": 36,
    "start": 120.01,
    "end": 122.05,
    "text": "کے لیئے اپنی سینا کے نائکوں کے نام میں"
  },
  {
    "index": 37,
    "start": 122.05,
    "end": 123.05,
    "text": "آپ کو بتاتا ہوں"
  },
  {
    "index": 38,
    "start": 123.05,
    "end": 125.75,
    "text": "بھوان بیش مشچہ کرنشچہ کرپاشچہ"
  },
  {
    "index": 39,
    "start": 125.75,
    "end": 128.37,
    "text": "سمیتین جہا ہے اشوض تھا ماروی کرنش"
  },
  {
    "index": 40,
    "start": 128.37,
    "end": 130.01,
    "text": "سو مدتیست تھا تھے وچھا"
  },
  {
    "index": 41,
    "start": 130.01,
    "end": 132.21,
    "text": "ایتو سوائم آپ بیشم"
  },
  {
    "index": 42,
    "start": 132.21,
    "end": 134.87,
    "text": "کرن اور یود دویجای کرپاشارے"
  },
  {
    "index": 43,
    "start": 134.87,
    "end": 138.39,
    "text": "تتھا اشوض تھا ماروی کرن اور سومدت کا پوتر ہے"
  },
  {
    "index": 44,
    "start": 138.39,
    "end": 142.07,
    "text": "انی اچھا بہا ہشورا مدر تھے تکتجی بیتا ہا"
  },
  {
    "index": 45,
    "start": 142.07,
    "end": 145.39,
    "text": "نانا شسٹر پرہرنا ہا سروی یود دویشار دا ہا"
  },
  {
    "index": 46,
    "start": 145.39,
    "end": 148.11,
    "text": "میرے لی پران کیا کرنے کے لئے تیار"
  },
  {
    "index": 47,
    "start": 148.11,
    "end": 150.83,
    "text": "انی اٹھ پرکار کے شسٹر آسٹروں سے سو سجت"
  },
  {
    "index": 48,
    "start": 150.83,
    "end": 154.39,
    "text": "تتھا یود میں کشل اور بھی انی ایک شوروی رہے"
  },
  {
    "index": 49,
    "start": 154.39,
    "end": 158.31,
    "text": "اپریاب تم تدس ماکم بلم بھیش مابھی رکشتم"
  },
  {
    "index": 50,
    "start": 188.64,
    "end": 192.14,
    "text": "آپ سب لوگ بھیشم پتاما کی ہی سبور سے رکشا کرے"
  },
  {
    "index": 51,
    "start": 192.14,
    "end": 195.64,
    "text": "تستیہ سنجنے ین ہرشم قروفت دا پیتاما ہا"
  },
  {
    "index": 52,
    "start": 195.64,
    "end": 200.14,
    "text": "سمحن آدم ویندگیوچے ہی شنکھم ددموں پرتاپوان"
  },
  {
    "index": 53,
    "start": 200.14,
    "end": 204.57,
    "text": "اُس سمے کارو میں وید پرتاپی پیتاما ہا"
  },
  {
    "index": 54,
    "start": 204.57,
    "end": 206.73,
    "text": "بھیشم نے اس دوریودن کے حردے میں"
  },
  {
    "index": 55,
    "start": 206.73,
    "end": 211.31,
    "text": "ہرش اتپن کرتے ہوئے اُچ سور میں گارج کر شنکھ دوانی کی"
  },
  {
    "index": 56,
    "start": 211.31,
    "end": 216.05,
    "text": "پتا ہا شنکھاشچہ بھیریشچہ پنوانکہ کو مکھا ہا"
  },
  {
    "index": 57,
    "start": 216.45,
    "end": 220.25,
    "text": "ساہسای واب بھی مینتسا شبدست ملو بھوت"
  },
  {
    "index": 58,
    "start": 220.25,
    "end": 223.99,
    "text": "تتپستشات شنکھ مگارے دھول وشرنگی"
  },
  {
    "index": 59,
    "start": 223.99,
    "end": 226.05,
    "text": "آدیوادی ایک ساتھی بجوٹھے"
  },
  {
    "index": 60,
    "start": 226.05,
    "end": 228.65,
    "text": "جن کا بڑا بھانکر شبد ہو"
  },
  {
    "index": 61,
    "start": 228.65,
    "end": 232.75,
    "text": "تتہاہ شویتے رہے ریوکتے مہتی سیندنی ستو"
  },
  {
    "index": 62,
    "start": 232.75,
    "end": 236.65,
    "text": "مادہا ہا پاند وشچے و دیو شنکھوں پر ددمتو ہو"
  },
  {
    "index": 63,
    "start": 236.65,
    "end": 240.95,
    "text": "اس کے اُقران شویت اشوو سے یکت بھاروے رتھ میں بیٹھے ہوئے"
  },
  {
    "index": 64,
    "start": 240.95,
    "end": 244.05,
    "text": "مادہا شریکریشن اور پاند پوتر ارجن نے بھی"
  },
  {
    "index": 65,
    "start": 244.05,
    "end": 246.05,
    "text": "اپنے دیو شنک بجائے"
  },
  {
    "index": 66,
    "start": 246.05,
    "end": 249.05,
    "text": "پانچہ جنیم حرشی کے شو دیوادتتم دھنجایا"
  },
  {
    "index": 67,
    "start": 249.05,
    "end": 253.05,
    "text": "پانڈرم ددموں مہاشنکھم دیم کرمہ رکو درہا"
  },
  {
    "index": 68,
    "start": 253.05,
    "end": 256.12,
    "text": "بھگوان حشی کےش نے پاچ جنیا"
  },
  {
    "index": 69,
    "start": 256.12,
    "end": 260.12,
    "text": "دھنجے ارجن نے دیوادتت تتہاہ بھین کر کرن کرن کرنے والے بھیم نے"
  },
  {
    "index": 70,
    "start": 260.12,
    "end": 263.12,
    "text": "پاندوں نامک مہاشنک بجائیا"
  },
  {
    "index": 71,
    "start": 263.12,
    "end": 266.12,
    "text": "انا نتا بجائم راجا کنتی پوتروں یو دیشت رہا"
  },
  {
    "index": 72,
    "start": 266.12,
    "end": 269.12,
    "text": "نکلہ سہ دیوشت سو گھوشوں میں کشپوں"
  },
  {
    "index": 73,
    "start": 269.12,
    "end": 272.12,
    "text": "کنتی پوتر راجا یو دیشتر میں"
  },
  {
    "index": 74,
    "start": 272.12,
    "end": 276.12,
    "text": "انا تا بجائی نامک شنک اور نکل و سہ دیو نے کرماش"
  },
  {
    "index": 75,
    "start": 276.12,
    "end": 279.12,
    "text": "سو گھوش اور مڑی پشپک نامک شنک بجائے"
  },
  {
    "index": 76,
    "start": 279.12,
    "end": 283.12,
    "text": "کاششچ پر مشواصہ شکھنڈی چاہ مہارتہ"
  },
  {
    "index": 77,
    "start": 283.12,
    "end": 287.12,
    "text": "درشتدیموں ویراطشچا ساتی کشچا پر آجتہ"
  },
  {
    "index": 78,
    "start": 287.12,
    "end": 290.12,
    "text": "شریشت دنشوالے کاشی راج"
  },
  {
    "index": 79,
    "start": 290.12,
    "end": 292.12,
    "text": "مہارتی شکھنڈی"
  },
  {
    "index": 80,
    "start": 292.12,
    "end": 296.12,
    "text": "درشتدیم راجا ویراط اور آجیہ ساتی کی"
  },
  {
    "index": 81,
    "start": 297.12,
    "end": 301.12,
    "text": "دروپا دو دروپا دی آجتہ سروشہ پر تیوی پتے"
  },
  {
    "index": 82,
    "start": 301.12,
    "end": 304.12,
    "text": "سو بھا درشت مہا باہوش شنکھاندد مھو"
  },
  {
    "index": 83,
    "start": 304.12,
    "end": 305.12,
    "text": "پر تک پر تک"
  },
  {
    "index": 84,
    "start": 305.12,
    "end": 306.12,
    "text": "حیر آجن"
  },
  {
    "index": 85,
    "start": 306.12,
    "end": 310.12,
    "text": "راجا دروپا دروپا دی کے پوتر اور مہا باہو"
  },
  {
    "index": 86,
    "start": 310.12,
    "end": 312.12,
    "text": "سو بھا در ابھی منیوں"
  },
  {
    "index": 87,
    "start": 312.12,
    "end": 315.12,
    "text": "ان سب نے آلگ آلگ شنکھ بجائے"
  },
  {
    "index": 88,
    "start": 315.12,
    "end": 317.12,
    "text": "سو گھوشوں دھارتا راشترانا"
  },
  {
    "index": 89,
    "start": 317.12,
    "end": 319.12,
    "text": "حیدیانی ویداریت"
  },
  {
    "index": 90,
    "start": 319.12,
    "end": 321.12,
    "text": "نباشت پر تیوین چیو"
  },
  {
    "index": 91,
    "start": 321.12,
    "end": 323.12,
    "text": "تمولو ویننا دین"
  },
  {
    "index": 92,
    "start": 323.12,
    "end": 326.12,
    "text": "و بھا بھایم کر گھوش آکاش و پریتھوی پر گنجنے لگا"
  },
  {
    "index": 93,
    "start": 326.12,
    "end": 329.12,
    "text": "اور اس نے درتراشت کے پوتروں کے حردائے"
  },
  {
    "index": 94,
    "start": 329.12,
    "end": 330.12,
    "text": "ویدیے کر دیے"
  },
  {
    "index": 95,
    "start": 330.12,
    "end": 332.12,
    "text": "اتھا ویوستیتان درشتوہ"
  },
  {
    "index": 96,
    "start": 332.12,
    "end": 334.12,
    "text": "دھارتراشتران قپیدھو جہا"
  },
  {
    "index": 97,
    "start": 334.12,
    "end": 337.12,
    "text": "پرویت شسٹر سمپاتے دھنوڑ جمیہ پانڈاوہا"
  },
  {
    "index": 98,
    "start": 338.12,
    "end": 339.12,
    "text": "حیمہی پتے"
  },
  {
    "index": 99,
    "start": 339.12,
    "end": 342.12,
    "text": "اس پرکار جب یدھ پرارام بھونے والا ہی تھا"
  },
  {
    "index": 100,
    "start": 342.12,
    "end": 344.12,
    "text": "کی قپیدھوڑ آرجن میں"
  },
  {
    "index": 101,
    "start": 344.12,
    "end": 347.12,
    "text": "درتراشتر کے پوتروں کو ستت دیکھر"
  },
  {
    "index": 102,
    "start": 347.12,
    "end": 349.12,
    "text": "دھنوش اتھا کر بھگوان"
  },
  {
    "index": 103,
    "start": 349.12,
    "end": 351.12,
    "text": "حرشی کےش سے یہ شبد کہے"
  },
  {
    "index": 104,
    "start": 351.12,
    "end": 352.12,
    "text": "عرجن اواج"
  },
  {
    "index": 105,
    "start": 352.12,
    "end": 353.12,
    "text": "حرشی کےشم"
  },
  {
    "index": 106,
    "start": 353.12,
    "end": 355.12,
    "text": "تدالک کے مداما محیپتے"
  },
  {
    "index": 107,
    "start": 355.12,
    "end": 357.12,
    "text": "سینیور ہوئے اور مدھے"
  },
  {
    "index": 108,
    "start": 357.12,
    "end": 358.12,
    "text": "رتاستھا پائمے چود"
  },
  {
    "index": 109,
    "start": 359.12,
    "end": 360.24,
    "text": "عرجن نے کہا"
  },
  {
    "index": 110,
    "start": 360.24,
    "end": 364.24,
    "text": "ہے اچھوٹ میرے رت کو دون سے ناؤ کے مدھے کرا کی جئے"
  },
  {
    "index": 111,
    "start": 365.24,
    "end": 366.24,
    "text": "یا و دیتان رکشے ہیں"
  },
  {
    "index": 112,
    "start": 366.24,
    "end": 368.24,
    "text": "یو دکا مانوستیتان"
  },
  {
    "index": 113,
    "start": 368.24,
    "end": 369.24,
    "text": "کر مئا ساہ"
  },
  {
    "index": 114,
    "start": 369.24,
    "end": 371.24,
    "text": "یو دھا بھیمس مینن سمجھے میں"
  },
  {
    "index": 115,
    "start": 371.24,
    "end": 373.24,
    "text": "جس سے میں یو دکی اچھا سے"
  },
  {
    "index": 116,
    "start": 373.24,
    "end": 375.24,
    "text": "کھڑائم لوگوں کا ناریکشان کا سکوں"
  },
  {
    "index": 117,
    "start": 375.24,
    "end": 377.24,
    "text": "کہ اس یو دھ میں مجھتن کے ساتھ"
  },
  {
    "index": 118,
    "start": 377.24,
    "end": 378.24,
    "text": "یو دھ کرنا ہے"
  },
  {
    "index": 119,
    "start": 378.24,
    "end": 380.24,
    "text": "یو دھ سے مانانہ ویک شہم"
  },
  {
    "index": 120,
    "start": 380.24,
    "end": 381.24,
    "text": "یا ایتے ترا سماجتا ہا"
  },
  {
    "index": 121,
    "start": 381.24,
    "end": 383.24,
    "text": "دھارتراشتر سے دھر بھر یو دھے"
  },
  {
    "index": 122,
    "start": 383.24,
    "end": 385.24,
    "text": "پریے چی کی رشو ہا"
  },
  {
    "index": 123,
    "start": 385.24,
    "end": 387.63,
    "text": "دھر بھڑی دھارتراشتر"
  },
  {
    "index": 124,
    "start": 387.63,
    "end": 388.63,
    "text": "دھر یو دھن کا"
  },
  {
    "index": 125,
    "start": 388.63,
    "end": 390.63,
    "text": "یو دھ میں پریے چھاہنے والے"
  },
  {
    "index": 126,
    "start": 390.63,
    "end": 391.63,
    "text": "جو یہ رازہ لوگ"
  },
  {
    "index": 127,
    "start": 391.63,
    "end": 392.63,
    "text": "یہ کتر ہوئے ہیں"
  },
  {
    "index": 128,
    "start": 392.63,
    "end": 394.63,
    "text": "ان یو دھ کرنے والوں میں دیکھوں گا"
  },
  {
    "index": 129,
    "start": 395.63,
    "end": 396.63,
    "text": "سنجے واجئے"
  },
  {
    "index": 130,
    "start": 396.63,
    "end": 397.63,
    "text": "امکتو حرشی کے شو"
  },
  {
    "index": 131,
    "start": 397.63,
    "end": 398.63,
    "text": "گڑا کے شن بھارت"
  },
  {
    "index": 132,
    "start": 398.63,
    "end": 399.63,
    "text": "سینیو رو بھئی اور"
  },
  {
    "index": 133,
    "start": 399.63,
    "end": 401.63,
    "text": "مدهس تھا پیطوہ رتوطتمم"
  },
  {
    "index": 134,
    "start": 401.63,
    "end": 403.63,
    "text": "سنجے نے کہا"
  },
  {
    "index": 135,
    "start": 403.63,
    "end": 404.63,
    "text": "ہی بھارتراشتر"
  },
  {
    "index": 136,
    "start": 404.63,
    "end": 405.63,
    "text": "آجن کے اس پرکار کہنے"
  },
  {
    "index": 137,
    "start": 405.63,
    "end": 406.63,
    "text": "پر بھگوان"
  },
  {
    "index": 138,
    "start": 406.63,
    "end": 407.63,
    "text": "رشی کے شنے"
  },
  {
    "index": 139,
    "start": 407.63,
    "end": 408.63,
    "text": "دونوں سے ناوں"
  },
  {
    "index": 140,
    "start": 408.63,
    "end": 409.27,
    "text": "کے مدھے"
  },
  {
    "index": 141,
    "start": 409.27,
    "end": 410.63,
    "text": "اُدتم رت کو خرا کر کے"
  },
  {
    "index": 142,
    "start": 410.63,
    "end": 411.63,
    "text": "بھیش مدرون"
  },
  {
    "index": 143,
    "start": 411.63,
    "end": 412.63,
    "text": "پر مکتا ہے"
  },
  {
    "index": 144,
    "start": 412.63,
    "end": 413.63,
    "text": "سرویشان چا محیکشتام"
  },
  {
    "index": 145,
    "start": 413.63,
    "end": 414.63,
    "text": "او آج"
  },
  {
    "index": 146,
    "start": 414.63,
    "end": 415.63,
    "text": "پارتھ پشیتان"
  },
  {
    "index": 147,
    "start": 415.63,
    "end": 416.63,
    "text": "سموویتان"
  },
  {
    "index": 148,
    "start": 416.63,
    "end": 417.63,
    "text": "کورنیتی"
  },
  {
    "index": 149,
    "start": 447.69,
    "end": 449.69,
    "text": "سانسو حداشتے و سینیو رو بھئی"
  },
  {
    "index": 150,
    "start": 449.69,
    "end": 450.69,
    "text": "رو بھئی"
  },
  {
    "index": 151,
    "start": 450.69,
    "end": 451.69,
    "text": "تانس میکشتا"
  },
  {
    "index": 152,
    "start": 451.69,
    "end": 452.69,
    "text": "کونتے ہا سروان"
  },
  {
    "index": 153,
    "start": 452.69,
    "end": 453.69,
    "text": "بندھا وستیتان"
  },
  {
    "index": 154,
    "start": 453.69,
    "end": 454.69,
    "text": "اس پرکار"
  },
  {
    "index": 155,
    "start": 454.69,
    "end": 455.69,
    "text": "انسا بندھو"
  },
  {
    "index": 156,
    "start": 455.69,
    "end": 456.69,
    "text": "بندھا ہو"
  },
  {
    "index": 157,
    "start": 456.69,
    "end": 457.69,
    "text": "کو خڑے دیکھا"
  },
  {
    "index": 158,
    "start": 457.69,
    "end": 458.69,
    "text": "کنتی پوتر"
  },
  {
    "index": 159,
    "start": 458.69,
    "end": 459.69,
    "text": "آجن کامان کرنہ"
  },
  {
    "index": 160,
    "start": 459.69,
    "end": 460.69,
    "text": "سبھار گیا"
  },
  {
    "index": 161,
    "start": 460.69,
    "end": 461.69,
    "text": "اور رشا دیوک تو"
  },
  {
    "index": 162,
    "start": 461.69,
    "end": 462.98,
    "text": "حوکھ رو سینے کہا"
  },
  {
    "index": 163,
    "start": 462.98,
    "end": 463.46,
    "text": "آجن"
  },
  {
    "index": 164,
    "start": 463.46,
    "end": 463.98,
    "text": "آجن"
  },
  {
    "index": 165,
    "start": 463.98,
    "end": 464.98,
    "text": "آجن آج"
  },
  {
    "index": 166,
    "start": 464.98,
    "end": 465.98,
    "text": "کپیا"
  },
  {
    "index": 167,
    "start": 465.98,
    "end": 466.98,
    "text": "پریا ویشتو"
  },
  {
    "index": 168,
    "start": 466.98,
    "end": 468.98,
    "text": "ویشی دنی دنی دن براویت"
  },
  {
    "index": 169,
    "start": 468.98,
    "end": 469.98,
    "text": "درشتویم"
  },
  {
    "index": 170,
    "start": 469.98,
    "end": 470.98,
    "text": "سوجنام"
  },
  {
    "index": 171,
    "start": 470.98,
    "end": 472.98,
    "text": "سوجنام"
  },
  {
    "index": 172,
    "start": 477.98,
    "end": 478.98,
    "text": "دیکھا"
  },
  {
    "index": 173,
    "start": 478.98,
    "end": 480.98,
    "text": "میری انگشتیل ہوئے جاتے ہیں"
  },
  {
    "index": 174,
    "start": 480.98,
    "end": 482.98,
    "text": "مک بھی سوک رہا ہے"
  },
  {
    "index": 175,
    "start": 482.98,
    "end": 483.98,
    "text": "اور میری شریر میں کم"
  },
  {
    "index": 176,
    "start": 483.98,
    "end": 485.98,
    "text": "پتھا روانچ ہو رہا ہے"
  },
  {
    "index": 177,
    "start": 485.98,
    "end": 487.98,
    "text": "سیدمتی ممگا"
  },
  {
    "index": 178,
    "start": 487.98,
    "end": 489.98,
    "text": "ترانی مکھن چپریشتی"
  },
  {
    "index": 179,
    "start": 489.98,
    "end": 491.98,
    "text": "ویپتھوشت شریرے میں"
  },
  {
    "index": 180,
    "start": 491.98,
    "end": 492.98,
    "text": "رومحرشش چزائیتے"
  },
  {
    "index": 181,
    "start": 492.98,
    "end": 493.98,
    "text": "آجن نے کہا"
  },
  {
    "index": 182,
    "start": 493.98,
    "end": 495.98,
    "text": "ہے کریشنا"
  },
  {
    "index": 183,
    "start": 495.98,
    "end": 496.98,
    "text": "یود کی"
  },
  {
    "index": 184,
    "start": 496.98,
    "end": 497.98,
    "text": "اچھا رکھر"
  },
  {
    "index": 185,
    "start": 497.98,
    "end": 498.98,
    "text": "اپستتت ہوئے"
  },
  {
    "index": 186,
    "start": 498.98,
    "end": 499.98,
    "text": "انسوزنوں کو"
  },
  {
    "index": 187,
    "start": 499.98,
    "end": 500.98,
    "text": "دیکھا"
  },
  {
    "index": 188,
    "start": 500.98,
    "end": 502.98,
    "text": "میری انگشتیل ہوئے جاتے ہیں"
  },
  {
    "index": 189,
    "start": 502.98,
    "end": 504.98,
    "text": "مک بھی سوک رہا ہے"
  },
  {
    "index": 190,
    "start": 504.98,
    "end": 505.98,
    "text": "اور میری شریر میں"
  },
  {
    "index": 191,
    "start": 505.98,
    "end": 507.98,
    "text": "کم پتھا روانچ ہو رہا ہے"
  },
  {
    "index": 192,
    "start": 507.98,
    "end": 508.98,
    "text": "گانڈیوام"
  },
  {
    "index": 193,
    "start": 508.98,
    "end": 509.98,
    "text": "سرمستے"
  },
  {
    "index": 194,
    "start": 509.98,
    "end": 510.98,
    "text": "حستات وکچے وہ"
  },
  {
    "index": 195,
    "start": 510.98,
    "end": 511.98,
    "text": "پڑی دہے"
  },
  {
    "index": 196,
    "start": 511.98,
    "end": 512.98,
    "text": "نچہ شکنوں میں"
  },
  {
    "index": 197,
    "start": 512.98,
    "end": 513.98,
    "text": "وستاتوں بھمتی وچوں میں"
  },
  {
    "index": 198,
    "start": 513.98,
    "end": 514.98,
    "text": "منا ہے"
  },
  {
    "index": 199,
    "start": 514.98,
    "end": 515.98,
    "text": "میری ہاتھ سے"
  },
  {
    "index": 200,
    "start": 515.98,
    "end": 516.98,
    "text": "گانڈیو"
  },
  {
    "index": 201,
    "start": 516.98,
    "end": 517.98,
    "text": "ذنج کی رہا ہے"
  },
  {
    "index": 202,
    "start": 517.98,
    "end": 518.98,
    "text": "اور تو اچھا جو رہی ہے"
  },
  {
    "index": 203,
    "start": 518.98,
    "end": 519.98,
    "text": "میری من بھرمت سے"
  },
  {
    "index": 204,
    "start": 519.98,
    "end": 520.98,
    "text": "ہو رہا ہے"
  },
  {
    "index": 205,
    "start": 520.98,
    "end": 521.98,
    "text": "اور میں کھڑے رہنے میں"
  },
  {
    "index": 206,
    "start": 521.98,
    "end": 522.98,
    "text": "آسمرت ہو"
  },
  {
    "index": 207,
    "start": 522.98,
    "end": 523.98,
    "text": "نمیتانی چپشامی"
  },
  {
    "index": 208,
    "start": 523.98,
    "end": 524.98,
    "text": "ویپریتانی"
  },
  {
    "index": 209,
    "start": 524.98,
    "end": 525.98,
    "text": "کشو"
  },
  {
    "index": 210,
    "start": 525.98,
    "end": 526.98,
    "text": "نچہ شریر"
  },
  {
    "index": 211,
    "start": 526.98,
    "end": 527.98,
    "text": "نپشامی"
  },
  {
    "index": 212,
    "start": 527.98,
    "end": 528.98,
    "text": "حتو آسوزن مارے"
  },
  {
    "index": 213,
    "start": 528.98,
    "end": 529.98,
    "text": "ایک ایشف"
  },
  {
    "index": 214,
    "start": 529.98,
    "end": 530.98,
    "text": "میں شکنوں کو بھی"
  },
  {
    "index": 215,
    "start": 530.98,
    "end": 532.98,
    "text": "ویپریت ہی دیکھ رہا ہے"
  },
  {
    "index": 216,
    "start": 532.98,
    "end": 533.98,
    "text": "اور ید میں آہوے"
  },
  {
    "index": 217,
    "start": 533.98,
    "end": 534.98,
    "text": "اپنے سوزنوں کو"
  },
  {
    "index": 218,
    "start": 534.98,
    "end": 535.98,
    "text": "مارکہ کوئی"
  },
  {
    "index": 219,
    "start": 535.98,
    "end": 536.98,
    "text": "کلیان بھی نہیں دیکھتا ہے"
  },
  {
    "index": 220,
    "start": 536.98,
    "end": 537.98,
    "text": "نہ کنگشے"
  },
  {
    "index": 221,
    "start": 537.98,
    "end": 538.98,
    "text": "ویجیم"
  },
  {
    "index": 222,
    "start": 538.98,
    "end": 539.98,
    "text": "کشنے نہ"
  },
  {
    "index": 223,
    "start": 539.98,
    "end": 540.98,
    "text": "چھے رجیم"
  },
  {
    "index": 224,
    "start": 540.98,
    "end": 541.98,
    "text": "سکھانی چھا"
  },
  {
    "index": 225,
    "start": 541.98,
    "end": 542.98,
    "text": "کی مور رجیم"
  },
  {
    "index": 226,
    "start": 542.98,
    "end": 543.98,
    "text": "گویم کی بھوگر جی"
  },
  {
    "index": 227,
    "start": 543.98,
    "end": 544.98,
    "text": "ویتے نوہ"
  },
  {
    "index": 228,
    "start": 544.98,
    "end": 545.98,
    "text": "ہے کشنے"
  },
  {
    "index": 229,
    "start": 545.98,
    "end": 546.98,
    "text": "میں نا بیجے چاہتا ہے"
  },
  {
    "index": 230,
    "start": 546.98,
    "end": 547.98,
    "text": "نہ رجی"
  },
  {
    "index": 231,
    "start": 547.98,
    "end": 548.98,
    "text": "اور نہ سکو کوئی"
  },
  {
    "index": 232,
    "start": 548.98,
    "end": 549.98,
    "text": "چاہتا ہے"
  },
  {
    "index": 233,
    "start": 549.98,
    "end": 550.98,
    "text": "ہے گویند"
  },
  {
    "index": 234,
    "start": 550.98,
    "end": 551.98,
    "text": "ہمیں رجی سے"
  },
  {
    "index": 235,
    "start": 551.98,
    "end": 552.98,
    "text": "بھوگوں سے"
  },
  {
    "index": 236,
    "start": 552.98,
    "end": 553.98,
    "text": "اور جینے سے بھی"
  },
  {
    "index": 237,
    "start": 553.98,
    "end": 554.98,
    "text": "کیا پریوچن ہے"
  },
  {
    "index": 238,
    "start": 554.98,
    "end": 556.98,
    "text": "یہ شاہ مرتے"
  },
  {
    "index": 239,
    "start": 556.98,
    "end": 557.98,
    "text": "کنگشتام نو"
  },
  {
    "index": 240,
    "start": 557.98,
    "end": 558.98,
    "text": "رجیم"
  },
  {
    "index": 241,
    "start": 558.98,
    "end": 559.98,
    "text": "بھوگا ہا"
  },
  {
    "index": 242,
    "start": 559.98,
    "end": 560.98,
    "text": "سکھانی چا"
  },
  {
    "index": 243,
    "start": 560.98,
    "end": 561.98,
    "text": "تو ایمے"
  },
  {
    "index": 244,
    "start": 561.98,
    "end": 562.98,
    "text": "وستیتا"
  },
  {
    "index": 245,
    "start": 562.98,
    "end": 563.98,
    "text": "یدھے پرانانستکتوہ"
  },
  {
    "index": 246,
    "start": 563.98,
    "end": 564.98,
    "text": "دھنانی چا"
  },
  {
    "index": 247,
    "start": 564.98,
    "end": 565.98,
    "text": "ہمیں جن کے لئے"
  },
  {
    "index": 248,
    "start": 565.98,
    "end": 566.98,
    "text": "رجی"
  },
  {
    "index": 249,
    "start": 566.98,
    "end": 567.98,
    "text": "بھوگ"
  },
  {
    "index": 250,
    "start": 567.98,
    "end": 568.98,
    "text": "اور سکھا دی کی"
  },
  {
    "index": 251,
    "start": 568.98,
    "end": 569.98,
    "text": "چاہ ہے"
  },
  {
    "index": 252,
    "start": 569.98,
    "end": 570.98,
    "text": "ویہی لوگ دھن"
  },
  {
    "index": 253,
    "start": 570.98,
    "end": 571.98,
    "text": "اور جیون کی آشا کو"
  },
  {
    "index": 254,
    "start": 571.98,
    "end": 572.98,
    "text": "تیاکر"
  },
  {
    "index": 255,
    "start": 572.98,
    "end": 573.98,
    "text": "یدھنکھ رہے"
  },
  {
    "index": 256,
    "start": 573.98,
    "end": 574.98,
    "text": "آچا رہا"
  },
  {
    "index": 257,
    "start": 574.98,
    "end": 575.98,
    "text": "پتراہ"
  },
  {
    "index": 258,
    "start": 575.98,
    "end": 576.98,
    "text": "پتراستتے وچہ"
  },
  {
    "index": 259,
    "start": 576.98,
    "end": 577.98,
    "text": "پتا مہاہا"
  },
  {
    "index": 260,
    "start": 608.2,
    "end": 609.2,
    "text": "دھرت راشتران"
  },
  {
    "index": 261,
    "start": 609.2,
    "end": 610.2,
    "text": "حکا پریتی"
  },
  {
    "index": 262,
    "start": 610.2,
    "end": 611.2,
    "text": "سیجناردن"
  },
  {
    "index": 263,
    "start": 611.2,
    "end": 612.2,
    "text": "پاپنے واشتر"
  },
  {
    "index": 264,
    "start": 612.2,
    "end": 613.2,
    "text": "دسمان"
  },
  {
    "index": 265,
    "start": 613.2,
    "end": 614.78,
    "text": "حتو ایتان"
  },
  {
    "index": 266,
    "start": 614.78,
    "end": 615.78,
    "text": "تطائینا"
  },
  {
    "index": 267,
    "start": 615.78,
    "end": 616.78,
    "text": "ایجناردن"
  },
  {
    "index": 268,
    "start": 616.78,
    "end": 617.78,
    "text": "دھرت راشتر"
  },
  {
    "index": 269,
    "start": 617.78,
    "end": 618.78,
    "text": "کی پوتروں"
  },
  {
    "index": 270,
    "start": 618.78,
    "end": 619.78,
    "text": "کی حتیہ کرکہ"
  },
  {
    "index": 271,
    "start": 619.78,
    "end": 620.78,
    "text": "ہمیں کیا بسان پہ ہوگی"
  },
  {
    "index": 272,
    "start": 620.78,
    "end": 621.78,
    "text": "ان آتتایوں"
  },
  {
    "index": 273,
    "start": 621.78,
    "end": 622.78,
    "text": "کو مار کرتو"
  },
  {
    "index": 274,
    "start": 622.78,
    "end": 623.78,
    "text": "ہمیں قیول"
  },
  {
    "index": 275,
    "start": 623.78,
    "end": 624.78,
    "text": "پاپ ہی لگے گا"
  },
  {
    "index": 276,
    "start": 624.78,
    "end": 625.78,
    "text": "تسمان نار ہا"
  },
  {
    "index": 277,
    "start": 625.78,
    "end": 626.78,
    "text": "ویم"
  },
  {
    "index": 278,
    "start": 626.78,
    "end": 627.78,
    "text": "حنتم"
  },
  {
    "index": 279,
    "start": 627.78,
    "end": 628.78,
    "text": "دھرت راشتران"
  },
  {
    "index": 280,
    "start": 628.78,
    "end": 629.78,
    "text": "سو بندھوان"
  },
  {
    "index": 281,
    "start": 629.78,
    "end": 630.78,
    "text": "سوجنم ہی"
  },
  {
    "index": 282,
    "start": 630.78,
    "end": 631.78,
    "text": "قتھم حتوہ"
  },
  {
    "index": 283,
    "start": 631.78,
    "end": 632.78,
    "text": "سکھنہ"
  },
  {
    "index": 284,
    "start": 634.04,
    "end": 635.04,
    "text": "ہی مادھا"
  },
  {
    "index": 285,
    "start": 635.04,
    "end": 636.04,
    "text": "اس لیے اپنے بندھو"
  },
  {
    "index": 286,
    "start": 636.04,
    "end": 637.04,
    "text": "دھراشتر"
  },
  {
    "index": 287,
    "start": 637.04,
    "end": 638.04,
    "text": "کی پوتروں کو مارنا"
  },
  {
    "index": 288,
    "start": 638.04,
    "end": 640.04,
    "text": "ہمارے لیے یوبگی نہیں ہے"
  },
  {
    "index": 289,
    "start": 640.04,
    "end": 641.1,
    "text": "کیوں کی"
  },
  {
    "index": 290,
    "start": 641.1,
    "end": 642.1,
    "text": "سوجنو کو مار کر"
  },
  {
    "index": 291,
    "start": 642.1,
    "end": 643.1,
    "text": "ہم کیسے سکھی ہوگے"
  },
  {
    "index": 292,
    "start": 643.1,
    "end": 644.23,
    "text": "یادیہ"
  },
  {
    "index": 293,
    "start": 644.23,
    "end": 645.23,
    "text": "پیتے نپاشن"
  },
  {
    "index": 294,
    "start": 645.23,
    "end": 646.23,
    "text": "تی"
  },
  {
    "index": 295,
    "start": 646.23,
    "end": 647.23,
    "text": "لوگ ہو پاہتا چیتا سہا"
  },
  {
    "index": 296,
    "start": 647.23,
    "end": 649.23,
    "text": "کلکشے کرتا مدرد روحی"
  },
  {
    "index": 297,
    "start": 649.23,
    "end": 650.23,
    "text": "چا پاہتکم"
  },
  {
    "index": 298,
    "start": 650.23,
    "end": 651.23,
    "text": "یادیہ"
  },
  {
    "index": 299,
    "start": 652.23,
    "end": 653.23,
    "text": "کلکشے"
  },
  {
    "index": 300,
    "start": 653.23,
    "end": 654.23,
    "text": "پرنششیم"
  },
  {
    "index": 301,
    "start": 654.23,
    "end": 655.23,
    "text": "تی"
  },
  {
    "index": 302,
    "start": 655.23,
    "end": 656.23,
    "text": "کلدھر ماہا سانہتنا"
  },
  {
    "index": 303,
    "start": 656.23,
    "end": 657.23,
    "text": "ہا"
  },
  {
    "index": 304,
    "start": 657.23,
    "end": 658.23,
    "text": "دھر میں نشتے"
  },
  {
    "index": 305,
    "start": 658.23,
    "end": 659.23,
    "text": "کلم"
  },
  {
    "index": 306,
    "start": 659.23,
    "end": 661.23,
    "text": "کلم"
  },
  {
    "index": 307,
    "start": 661.23,
    "end": 662.23,
    "text": "کلم"
  },
  {
    "index": 308,
    "start": 662.23,
    "end": 664.23,
    "text": "کلم"
  },
  {
    "index": 309,
    "start": 664.23,
    "end": 665.23,
    "text": "کلم"
  },
  {
    "index": 310,
    "start": 665.23,
    "end": 666.23,
    "text": "کلم"
  },
  {
    "index": 311,
    "start": 666.23,
    "end": 667.23,
    "text": "کلم"
  },
  {
    "index": 312,
    "start": 667.23,
    "end": 668.23,
    "text": "کلم"
  },
  {
    "index": 313,
    "start": 668.23,
    "end": 669.23,
    "text": "کلم"
  },
  {
    "index": 314,
    "start": 669.23,
    "end": 670.23,
    "text": "کلم"
  },
  {
    "index": 315,
    "start": 670.23,
    "end": 671.23,
    "text": "کلم"
  },
  {
    "index": 316,
    "start": 671.23,
    "end": 673.23,
    "text": "کلم"
  },
  {
    "index": 317,
    "start": 673.23,
    "end": 675.26,
    "text": "کلم"
  },
  {
    "index": 318,
    "start": 675.26,
    "end": 676.26,
    "text": "کلم"
  },
  {
    "index": 319,
    "start": 676.26,
    "end": 677.26,
    "text": "کلم"
  },
  {
    "index": 320,
    "start": 677.26,
    "end": 678.26,
    "text": "کلم"
  },
  {
    "index": 321,
    "start": 678.26,
    "end": 679.26,
    "text": "سے"
  },
  {
    "index": 322,
    "start": 709.26,
    "end": 714.26,
    "text": "پینڈ اور جلدان کی قریعہ سے ونچت ان کے پتر بھی نرک میں گیر جاتے ہیں"
  },
  {
    "index": 323,
    "start": 714.26,
    "end": 718.26,
    "text": "دوشے رہے تھے ہی کلگھنا نام ورنسن کر کارکے ہی اُت ساتھ دنٹے جاتی دھرمہا"
  },
  {
    "index": 324,
    "start": 718.26,
    "end": 723.39,
    "text": "کلگھا ششوتہ ہا۔ اِن مونسن کا کارک دوشوں سے کلگھا تھی دوشوں سے"
  },
  {
    "index": 325,
    "start": 723.39,
    "end": 728.39,
    "text": "سناتن کلگھا اور جاتی دھر مستھ ہو جاتے ہیں ۔ اُت سن نکل دھرمانا مششانا جناردن"
  },
  {
    "index": 326,
    "start": 758.71,
    "end": 762.71,
    "text": "شوکھ ہے کہ ہم لوگ بڑا بھاری پاپ کرنے کا نشچے کر بیٹھ ہیں"
  },
  {
    "index": 327,
    "start": 762.71,
    "end": 768.71,
    "text": "جو کی اس راجسوک کے لوگ سے اپنے کٹوں کا ناش کرنے کے لیے تیار ہو گئے ہیں"
  },
  {
    "index": 328,
    "start": 768.71,
    "end": 775.74,
    "text": "یہ دی ماما پر تیکار مشسترم شستر پانے ہا۔ دھارتا راشترا رہنے ہمیوستن مکشانترا محبت"
  },
  {
    "index": 329,
    "start": 775.74,
    "end": 782.74,
    "text": "یہ دی مجھ شستر رہت اور پر تیکار نہ کرنے والے کو یہ شستر دھاری کارک اور فرن میں ماری"
  },
  {
    "index": 330,
    "start": 782.74,
    "end": 791.03,
    "text": "تو بھی وہے میرے لیے کر لیان کر رکھ ہو گئے۔ سنجے او آج ایو مکتوار جونہ سنکے رتھو پس تو پاویشت"
  },
  {
    "index": 331,
    "start": 791.03,
    "end": 796.03,
    "text": "ویسرج سشرم چاپم شوک سم بگنمان ساہ سنجے نکا ہے"
  },
  {
    "index": 332,
    "start": 796.03,
    "end": 800.06,
    "text": "رنم ہومی سنکے میں شوک سے ادوگنمانوالا ارجن"
  },
  {
    "index": 333,
    "start": 800.06,
    "end": 806.06,
    "text": "اس پرکار کہ کر بان سحب دھنش کو تیاک کر رہت کے پیشلے بھاگ میں بیٹھ ہے"
  }
]